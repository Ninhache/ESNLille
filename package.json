{
  "name": "esn-lille-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm fonts && next dev",
    "build": "pnpm fonts && next build",
    "start": "next start",
    "fonts": "sh scripts/fonts.sh",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "check:staged": "biome check --staged --error-on-warnings --no-errors-on-unmatched",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.33.0"
}
